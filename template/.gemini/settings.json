{
  "context": {
    "fileName": ["AGENTS.md"]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_file|replace|run_shell_command",
        "hooks": [
          {
            "name": "craft-harness",
            "type": "command",
            "command": "node \"${GEMINI_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/harness/agent-hook.mjs\"",
            "description": "Refuse edits to human-owned files and commands that bypass the gates"
          }
        ]
      }
    ]
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "no-explicit-any": "error"
  },
  "ignorePatterns": ["dist", "coverage", "scripts/harness"]
}
